DATABASE_URL=sqlite:///./inbox_agent.db

# Empty LLM_BASE_URL = OpenAI. For a free OpenAI-compatible provider:
# Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai/  (model: gemini-flash-latest)
# Groq          : https://api.groq.com/openai/v1                            (model: llama-3.3-70b-versatile)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Google Cloud OAuth credentials (console.cloud.google.com -> APIs & Services -> Credentials).
# Enable the Gmail API on the project, create an OAuth 2.0 Client ID (Web application),
# and add GOOGLE_REDIRECT_URI below as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8050/api/gmail/callback

# Where the backend redirects back to after a successful Gmail connection.
FRONTEND_URL=http://localhost:5173

CORS_ORIGINS=["http://localhost:5173"]

# Optional: gate the whole app behind a single shared password in production.
SITE_PASSWORD=
